{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "task",
    "date",
    "time",
    "needs_clarification",
    "clarification_question"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["CREATE", "RESCHEDULE", "SNOOZE", "CLARIFY"]
    },
    "task": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "date": {
      "type": ["string", "null"],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": ["string", "null"],
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_question": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"intent": {"const": "CREATE"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "task": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "needs_clarification": {"const": false},
          "clarification_question": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "RESCHEDULE"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "task": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "needs_clarification": {"const": false},
          "clarification_question": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "SNOOZE"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "task": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
          "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "needs_clarification": {"const": false},
          "clarification_question": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"intent": {"const": "CLARIFY"}},
        "required": ["intent"]
      },
      "then": {
        "properties": {
          "needs_clarification": {"const": true},
          "clarification_question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
